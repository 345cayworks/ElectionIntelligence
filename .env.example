# =====================================================================
# Election Intelligence - environment configuration
# Copy to `.env` and fill in. Never commit the populated file.
# =====================================================================

# --- Database --------------------------------------------------------
# REQUIRED. PostgreSQL connection string (Neon / Netlify Database /
# Supabase / RDS / local Postgres). SQLite is NOT supported because
# serverless platforms (Netlify, Vercel) have no writable filesystem
# at runtime - any DB write would crash the function.
#
# Examples:
#   Neon / Netlify Database / Supabase: starts with "postgresql://" and
#   includes `?sslmode=require` and (optionally) `&pgbouncer=true`.
#   Local docker:   postgresql://postgres:postgres@localhost:5432/ei
#
# After setting this, run:  npx prisma migrate deploy
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# --- Tracking & Analytics --------------------------------------------
# Tracking only loads when ENABLED is true AND a relevant ID is set.
# Missing IDs do not crash the app.
NEXT_PUBLIC_ENABLE_TRACKING=false
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_TAG_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# --- App identity (public, optional) ---------------------------------
NEXT_PUBLIC_APP_NAME="Election Intelligence"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- SuperAdmin bootstrap (SERVER ONLY) ------------------------------
# On first boot, the platform seeds a SuperAdmin from this email.
# The temporary password is logged to server output only and must be
# rotated immediately on first login.
SUPER_ADMIN_EMAIL=

# Server-only master key used as a high-trust gate for sensitive
# SuperAdmin actions (e.g. confirming master-key rotation intent).
# NEVER use NEXT_PUBLIC_* for this value. NEVER commit a real value.
# Minimum 16 characters. The actual key is never displayed in the UI.
SUPERADMIN_MASTER_KEY=

# Optional seed-time override for the seed script's initial password.
# Only used by `npm run db:seed`. Defaults to a hard-coded value if
# omitted; either way the user is forced to reset on first login.
SUPER_ADMIN_SEED_PASSWORD=

# --- Scheduled portal sync (SERVER ONLY) -----------------------------
# Bearer token for unauthenticated invocations of
# /api/scheduled/sync-portal (Netlify scheduled function, GitHub
# Actions cron, etc.). Minimum 16 chars. Leave blank to disable
# unauthenticated scheduling - SuperAdmins can still trigger the
# scraper manually from a signed-in session.
SCHEDULED_SYNC_TOKEN=

# --- Cayworks Ads Engine (SERVER ONLY) -------------------------------
# Toggle whether ads attempt to load on public pages.
NEXT_PUBLIC_ENABLE_ADS=false

# The base URL of the Cayworks Ads Engine. Defaults to ads.cayworks.com.
AD_ENGINE_BASE_URL=https://ads.cayworks.com

# The platform slug registered with the Ads Engine for this app.
AD_ENGINE_PLATFORM=election-intelligence

# The server-only API key for the Ads Engine. NEVER use NEXT_PUBLIC_*
# for this value. NEVER commit a real key. NEVER pass it in URLs.
# The platform reads this only inside src/lib/ads/server-client.ts.
AD_ENGINE_KEY=
